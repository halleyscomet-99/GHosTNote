<?xml version="1.0"?>
<package format="3">
  <name>ghost_controller</name>
  <version>0.1.0</version>
  <description>GHOST impedance controller: stiffness k scales kp / kd every cycle; MuJoCo inverse-dynamics feedforward; trajectory and teleop-stream references; latched safety stop.</description>
  <maintainer email="halleyscomet678@gmail.com">Halley Zhong</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>controller_interface</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>realtime_tools</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>trajectory_msgs</depend>
  <depend>ghost_hardware</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
