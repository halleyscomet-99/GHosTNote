<?xml version="1.0"?>
<package format="3">
  <name>ghost_teleop</name>
  <version>0.1.0</version>
  <description>GHOST teleop on ROS 2: myo_bridge (live_stiffness UDP -> /ghost/k, /ghost/imu/*) and imu_teleop (two-Myo whole-arm teleop into ghost_controller).</description>
  <maintainer email="halleyscomet678@gmail.com">Halley Zhong</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>ghost_sim2real</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
