<?xml version="1.0"?>
<package format="3">
  <name>ghost_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configs for GHOST on OpenArm: MuJoCo or the real arm, RViz, the twin viewer.</description>
  <maintainer email="halleyscomet678@gmail.com">Halley Zhong</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>ghost_description</exec_depend>
  <exec_depend>ghost_hardware</exec_depend>
  <exec_depend>ghost_controller</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
